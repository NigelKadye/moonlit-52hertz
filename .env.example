PING_MESSAGE=ping

# Paynow (set these values locally and in Netlify site environment variables)
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
PAYNOW_RETURN_URL=https://your-site.netlify.app/find-our-book
PAYNOW_RESULT_URL=https://your-site.netlify.app/api/paynow/result

# Optional overrides
BOOK_PRICE_USD=20
PAYNOW_INITIATE_URL=https://www.paynow.co.zw/interface/initiatetransaction
