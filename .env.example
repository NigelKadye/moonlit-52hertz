PING_MESSAGE=ping

# Paynow (set these values in Netlify site environment variables)
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
PAYNOW_RETURN_URL=https://52hertz.co.zw/find-our-book
PAYNOW_RESULT_URL=https://52hertz.co.zw/api/paynow/result

# Optional overrides
BOOK_PRICE_USD=20
PAYNOW_INITIATE_URL=https://www.paynow.co.zw/interface/initiatetransaction

# Paynow hosted BillPayment link (used for "Hosted Paynow Link" mode on the checkout page)
PAYNOW_BILLPAYMENT_URL=https://www.paynow.co.zw/Payment/BillPaymentLink/?q=your_encoded_params

# Contact form email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
CONTACT_EMAIL=val@52hertz.co.zw
